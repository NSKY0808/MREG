            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Value"
        },
        "candidate_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Value"
        },
        "compared_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compared Value"
        },
        "evidence_references": {
          "items": {
            "type": "string"
          },
